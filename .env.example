# Copy this file to .env and fill in your keys. .env is never committed.

# Order to try the language-model providers. The first that answers wins;
# if it errors, is rate-limited or returns a malformed tool call, the next is tried.
# Gemini first (13 Nov 2026): understood every test turn, about 0.9 s per call. Groq is the backup.
LLM_PROVIDERS=gemini,groq
# Seconds to wait for one model call before trying the next provider.
LLM_TIMEOUT_SECONDS=4
# If the first provider has not answered after this many seconds, the next one is asked as well.
LLM_HEDGE_SECONDS=1.5

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss is a reasoning model; "low" cuts a call from 1-3.6 s to about 0.7 s.
GROQ_REASONING_EFFORT=low

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# flash-lite: about 1.2 s per call. gemini-3.8-flash took 4-5 s whatever the thinking setting.
GEMINI_MODEL=gemini-3.5-flash-lite
# Leave empty: "low"/"none" made no difference to Gemini's speed, and "minimal" is rejected.
GEMINI_REASONING_EFFORT=

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys) for the voice: speech-to-text and the
# spoken answer. Without it the voice buttons are hidden; the map and typed chat keep working.
ELEVENLABS_API_KEY=

# Port for the local server
PORT=8000

# Watch emails (13 Nov 2026): a Gmail address to send from, and its 16-character app password
# (Google Account > Security > 2-Step Verification on > App passwords). Leave empty to send no email.
SMTP_USER=
SMTP_PASSWORD=
